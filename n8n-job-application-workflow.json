        "method": "POST",
        "url": "={{ $('Load local settings').first().json.workerUrl + '/start' }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ {provider: $('Load local settings').first().json.provider, mode: 'expanded'} }}",
        "options": {
          "timeout": 660000
        }
      },
      "credentials": {}

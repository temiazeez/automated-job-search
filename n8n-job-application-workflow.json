    {
      "id": "schedule",
      "name": "Every day at 10 AM Lagos",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 0 10 * * *"
            }
          ]
        }
      }
    },
    {
      "id": "manual",
      "name": "Run manually",

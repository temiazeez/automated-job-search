      "id": "sources",
      "name": "Sources",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        820,
        -180
      ],
      "parameters": {
        "width": 900,
        "height": 130,
        "content": "## All job platforms\nAutomatic free feeds: Himalayas, Remotive and Jobicy. Gmail Job Alerts + Sheet Inbox capture exact links from LinkedIn, Indeed, Glassdoor, Google Jobs, Mercor, Turing, Micro1 and any other platform. Start daily queue refreshes the clickable Sources sheet every run. Unsupported on-site applications remain Manual application with their job URL and tailored CV link.",
        "color": 5
      }
    },
    {
      "id": "quality",
      "name": "CV and ATS",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        1800,
        300
      ],
      "parameters": {
        "width": 900,
        "height": 140,
        "content": "## CV and ATS\nThe profile check exposes only fact counts. Tailoring, ATS assessment, up to three truthful rewrites, PDF rendering and Drive upload run as separate worker stages.",
        "color": 5
      }
    },
    {
      "id": "apply",
      "name": "Application routes",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        1800,
        700
      ],
      "parameters": {
        "width": 900,
        "height": 140,
        "content": "## Application routes\nThe render stage decides the route. A verified employer address can use the Gmail fallback when submission is enabled. Platforms without an approved submission connection remain Manual application, and Sheets keeps the exact job link plus the tailored CV link.",
        "color": 5
      }
    },
    {
      "id": "tracker",
      "name": "Tracking",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        900,
        1050
      ],
      "parameters": {
        "width": 900,
        "height": 130,
        "content": "## Tracking\nEvery job is written to Google Sheets with its description, status, score, direct link, and tailored CV Drive link.",
        "color": 5
      }
    },
    {
      "id": "debug",
      "name": "Troubleshooting",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        0,
        1050
      ],
      "parameters": {
        "width": 800,
        "height": 130,
        "content": "## Troubleshooting\nClick the last failed node. Its output states the worker action, source, job id, current stage, and reason.",
        "color": 5
      }
    }
